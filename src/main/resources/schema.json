{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "views": {
      "type": "string"
    },
    "jobs": {
      "type": "array",
      "items": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ]
    },
    "book": {
      "type": "object",
      "properties": {
        "isbn": {
          "type": "integer"
        },
        "year": {
          "type": "integer"
        },
        "author": {
          "type": "string"
        }
      },
      "required": [
        "isbn",
        "year",
        "author"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "title",
    "views",
    "jobs",
    "book"
  ]
}